-- Safe Parent Resolver
local function GetSafeGuiParent()
    local success, parent = pcall(function()
        if typeof(gethui) == "function" then
            return gethui()
        end
        return game:GetService("CoreGui")
    end)
    if success and parent then
        return parent
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- Tween Helper
local function Tween(instance, info, props)
    local tw = TweenService:Create(instance, info, props)
    tw:Play()
    return tw
end

-- Font Resolver
local function ApplyFont(label, weight)
    label.Font = Enum.Font.Gotham
    pcall(function()
        local w = Enum.FontWeight.Regular
        if weight == "Medium" then
            w = Enum.FontWeight.Medium
        elseif weight == "Bold" then
            w = Enum.FontWeight.Bold
        elseif weight == "Heavy" or weight == "Black" then
            w = Enum.FontWeight.Heavy
        end
        label.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", w)
    end)
end

-- Exact Material Design 3 Palette (matched to the original Settings Menu)
local function GetTheme(customPrimary)
    local primary = customPrimary or Color3.fromRGB(255, 182, 140) -- Exact original peach/salmon
    return {
        background = Color3.fromRGB(32, 26, 23),          -- Exact original warm espresso dark
        surface = Color3.fromRGB(38, 31, 27),
        surfaceVariant = Color3.fromRGB(68, 54, 49),
        onBackground = Color3.fromRGB(236, 224, 219),     -- Off-white text and icons
        onSurface = Color3.fromRGB(236, 224, 219),
        onSurfaceVariant = Color3.fromRGB(160, 141, 132), -- Muted description text
        outline = Color3.fromRGB(137, 120, 113),          -- Border outline
        outlineVariant = Color3.fromRGB(68, 54, 49),
        primary = primary,                                -- Pastel peach accent
        onPrimary = Color3.fromRGB(85, 33, 0),            -- Deep dark brown (switch thumb)
        primaryContainer = Color3.fromRGB(95, 42, 10),
        secondaryContainer = Color3.fromRGB(70, 52, 45),  -- Slider background rail
        onSecondaryContainer = Color3.fromRGB(236, 224, 219),
    }
end

