                local duration = animate and 0.22 or 0
                local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

                if enabled then
                    -- When ON: Track is peach, Thumb is dark espresso brown
                    Tween(switchTrack, tweenInfo, { BackgroundColor3 = theme.primary })
                    Tween(switchStroke, tweenInfo, { Transparency = 1 })
                    Tween(switchThumb, tweenInfo, {
                        Size = UDim2.fromOffset(22, 22),
                        Position = UDim2.new(1, -25, 0.5, 0),
                        BackgroundColor3 = theme.onPrimary -- Color3.fromRGB(85, 33, 0)
                    })
                else
                    -- When OFF: Track is surfaceVariant, Thumb is outline
                    Tween(switchTrack, tweenInfo, { BackgroundColor3 = theme.surfaceVariant })
                    Tween(switchStroke, tweenInfo, { Transparency = 0, Color = theme.outline })
                    Tween(switchThumb, tweenInfo, {
                        Size = UDim2.fromOffset(16, 16),
                        Position = UDim2.new(0, 5, 0.5, 0),
                        BackgroundColor3 = theme.outline
                    })
                end
            end

            UpdateVisual(false)

            tile.MouseEnter:Connect(function()
                Tween(tile, TweenInfo.new(0.18), { BackgroundTransparency = 0.96 })
            end)
            tile.MouseLeave:Connect(function()
                Tween(tile, TweenInfo.new(0.18), { BackgroundTransparency = 1 })
            end)

            local debounce = false
            tile.MouseButton1Click:Connect(function()
                if debounce then return end
                debounce = true
                enabled = not enabled
                UpdateVisual(true)
                task.spawn(callback, enabled)
                if options.ChangedEvent then
                    task.spawn(options.ChangedEvent, enabled)
                end
                task.delay(0.25, function() debounce = false end)
            end)

            local ToggleObj = {
                Value = enabled,
                Tile = tile,
            }

            function ToggleObj:Set(val)
                if enabled ~= val then
                    enabled = val
                    ToggleObj.Value = enabled
                    UpdateVisual(true)
                    task.spawn(callback, enabled)
                end
            end

            return ToggleObj
        end

