-- Safe Parent Resolver
local function GetSafeGuiParent()
    local success, parent = pcall(function()
        if typeof(gethui) == "function" then
            return gethui()
        end
        return game:GetService("CoreGui")
    end)
    if success and parent then
        return parent
    end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- Tween Helper
local function Tween(instance, info, props)
    local tw = TweenService:Create(instance, info, props)
    tw:Play()
    return tw
end

-- Font Resolver
local function ApplyFont(label, weight)
    label.Font = Enum.Font.Gotham
    pcall(function()
        local w = Enum.FontWeight.Regular
        if weight == "Medium" then
            w = Enum.FontWeight.Medium
        elseif weight == "Bold" then
            w = Enum.FontWeight.Bold
        elseif weight == "Heavy" or weight == "Black" then
            w = Enum.FontWeight.Heavy
        end
        label.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", w)
    end)
end

-- Theme generator
local function CreateTheme(primaryColor)
    primaryColor = primaryColor or Color3.fromRGB(255, 110, 40)
    return {
        background = Color3.fromRGB(24, 25, 29),
        surface = Color3.fromRGB(31, 32, 37),
        surfaceVariant = Color3.fromRGB(43, 45, 52),
        onBackground = Color3.fromRGB(228, 228, 233),
        onSurface = Color3.fromRGB(228, 228, 233),
        onSurfaceVariant = Color3.fromRGB(155, 158, 168),
        outline = Color3.fromRGB(72, 75, 84),
        outlineVariant = Color3.fromRGB(50, 52, 60),
        primary = primaryColor,
        onPrimary = Color3.fromRGB(25, 10, 2),
        primaryContainer = Color3.fromRGB(70, 32, 14),
        secondaryContainer = Color3.fromRGB(50, 52, 62),
        onSecondaryContainer = Color3.fromRGB(218, 220, 230),
    }
end

