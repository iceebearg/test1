                    Tween(barStroke, TweenInfo.new(0.2), { Color = theme.primary, Transparency = 0 })
                    Tween(icon, TweenInfo.new(0.2), { ImageColor3 = theme.primary })
                end)
                searchBox.FocusLost:Connect(function()
                    Tween(barStroke, TweenInfo.new(0.2), { Color = theme.outlineVariant, Transparency = 0.5 })
                    Tween(icon, TweenInfo.new(0.2), { ImageColor3 = theme.onSurfaceVariant })
                end)
