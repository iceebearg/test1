                iconLabel.Parent = leftContainer
            end

            local textHolder = Instance.new("Frame")
            textHolder.Name = "TextHolder"
            textHolder.Size = UDim2.new(1, icon and -38 or 0, 1, 0)
            textHolder.BackgroundTransparency = 1
            textHolder.Parent = leftContainer

            local textLayout = Instance.new("UIListLayout")
            textLayout.FillDirection = Enum.FillDirection.Vertical
            textLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            textLayout.Padding = UDim.new(0, 2)
            textLayout.Parent = textHolder

            local titleLabel = Instance.new("TextLabel")
            titleLabel.Name = "Title"
            titleLabel.Size = UDim2.new(1, 0, 0, 20)
            titleLabel.BackgroundTransparency = 1
            titleLabel.Text = title
            titleLabel.TextColor3 = theme.onBackground
            titleLabel.TextSize = 15
            titleLabel.TextXAlignment = Enum.TextXAlignment.Left
            ApplyFont(titleLabel, "Bold")
            titleLabel.Parent = textHolder

            if desc ~= "" then
                local descLabel = Instance.new("TextLabel")
                descLabel.Name = "Description"
                descLabel.Size = UDim2.new(1, 0, 0, 16)
                descLabel.BackgroundTransparency = 1
                descLabel.Text = desc
                descLabel.TextColor3 = theme.onSurfaceVariant
                descLabel.TextSize = 12
                descLabel.TextXAlignment = Enum.TextXAlignment.Left
                ApplyFont(descLabel, "Regular")
                descLabel.Parent = textHolder
            end

            -- Right Action Badge / Pill
            local badge = Instance.new("Frame")
            badge.Name = "ActionBadge"
            badge.AnchorPoint = Vector2.new(1, 0.5)
            badge.Position = UDim2.fromScale(1, 0.5)
            badge.Size = UDim2.fromOffset(72, 32)
            badge.BackgroundColor3 = theme.primaryContainer
            badge.BorderSizePixel = 0
            badge.Parent = tile

            local badgeCorner = Instance.new("UICorner")
            badgeCorner.CornerRadius = UDim.new(1, 0)
            badgeCorner.Parent = badge

            local badgeLabel = Instance.new("TextLabel")
            badgeLabel.Size = UDim2.fromScale(1, 1)
            badgeLabel.BackgroundTransparency = 1
            badgeLabel.Text = options.ButtonText or "Execute"
            badgeLabel.TextColor3 = theme.primary
            badgeLabel.TextSize = 12
            ApplyFont(badgeLabel, "Bold")
            badgeLabel.Parent = badge

            -- Hover & Click Tweens
            tile.MouseEnter:Connect(function()
                Tween(tile, TweenInfo.new(0.18), { BackgroundTransparency = 0.95 })
                Tween(badge, TweenInfo.new(0.18), { BackgroundColor3 = theme.primary })
                Tween(badgeLabel, TweenInfo.new(0.18), { TextColor3 = theme.onPrimary })
            end)
            tile.MouseLeave:Connect(function()
                Tween(tile, TweenInfo.new(0.18), { BackgroundTransparency = 1 })
                Tween(badge, TweenInfo.new(0.18), { BackgroundColor3 = theme.primaryContainer })
                Tween(badgeLabel, TweenInfo.new(0.18), { TextColor3 = theme.primary })
            end)

            tile.MouseButton1Click:Connect(function()
                Tween(badge, TweenInfo.new(0.1), { Size = UDim2.fromOffset(68, 28) })
                task.delay(0.1, function()
                    Tween(badge, TweenInfo.new(0.15), { Size = UDim2.fromOffset(72, 32) })
                end)
                task.spawn(callback)
            end)

            return tile
        end

        -- ==============================================================
        -- COMPONENT: LabelTile (Information Label)
        -- ==============================================================
        function TabObj:CreateLabel(text, desc, icon)
            TabObj.ItemCount = TabObj.ItemCount + 1

            local tile = Instance.new("Frame")
            tile.Name = "LabelTile"
            tile.Size = UDim2.new(1, 0, 0, desc and 54 or 40)
            tile.BackgroundTransparency = 1
            tile.LayoutOrder = TabObj.ItemCount
            tile.Parent = scrollPage

            local tilePadding = Instance.new("UIPadding")
            tilePadding.PaddingLeft = UDim.new(0, 16)
            tilePadding.PaddingRight = UDim.new(0, 16)
            tilePadding.PaddingTop = UDim.new(0, 6)
            tilePadding.PaddingBottom = UDim.new(0, 6)
            tilePadding.Parent = tile

            local leftContainer = Instance.new("Frame")
            leftContainer.Size = UDim2.fromScale(1, 1)
            leftContainer.BackgroundTransparency = 1
            leftContainer.Parent = tile

            local leftLayout = Instance.new("UIListLayout")
            leftLayout.FillDirection = Enum.FillDirection.Horizontal
            leftLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            leftLayout.Padding = UDim.new(0, 14)
            leftLayout.Parent = leftContainer

            if icon then
                local iconLabel = Instance.new("ImageLabel")
                iconLabel.Size = UDim2.fromOffset(20, 20)
                iconLabel.BackgroundTransparency = 1
                iconLabel.Image = icon
                iconLabel.ImageColor3 = theme.onSurfaceVariant
                iconLabel.Parent = leftContainer
            end

            local textHolder = Instance.new("Frame")
            textHolder.Size = UDim2.new(1, icon and -34 or 0, 1, 0)
            textHolder.BackgroundTransparency = 1
            textHolder.Parent = leftContainer

            local textLayout = Instance.new("UIListLayout")
            textLayout.FillDirection = Enum.FillDirection.Vertical
            textLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            textLayout.Padding = UDim.new(0, 2)
            textLayout.Parent = textHolder

            local titleLabel = Instance.new("TextLabel")
            titleLabel.Size = UDim2.new(1, 0, 0, 18)
            titleLabel.BackgroundTransparency = 1
            titleLabel.Text = text
            titleLabel.TextColor3 = theme.onSurface
            titleLabel.TextSize = 14
            titleLabel.TextXAlignment = Enum.TextXAlignment.Left
            ApplyFont(titleLabel, "Medium")
            titleLabel.Parent = textHolder

            if desc then
                local descLabel = Instance.new("TextLabel")
                descLabel.Size = UDim2.new(1, 0, 0, 14)
                descLabel.BackgroundTransparency = 1
                descLabel.Text = desc
                descLabel.TextColor3 = theme.onSurfaceVariant
                descLabel.TextSize = 12
                descLabel.TextXAlignment = Enum.TextXAlignment.Left
                ApplyFont(descLabel, "Regular")
                descLabel.Parent = textHolder
            end

            return tile
        end

        return TabObj
    end

    table.insert(MaterialUI.Windows, WindowObj)
    return WindowObj
end

return MaterialUI
