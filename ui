            local selectedPlayer = nil

            local function FilterRows()
                for player, row in pairs(playerRows) do
                    if searchTerm == "" then
                        row.Visible = true
                    else
                        local match = player.DisplayName:lower():find(searchTerm) or player.Name:lower():find(searchTerm)
                        row.Visible = match ~= nil
