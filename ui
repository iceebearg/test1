            local rail = Instance.new("Frame")
            rail.Name = "Rail"
            rail.AnchorPoint = Vector2.new(0.5, 0.5)
            rail.Position = UDim2.fromScale(0.5, 0.5)
            rail.Size = UDim2.new(1, 0, 0, 4)
            rail.BackgroundColor3 = theme.secondaryContainer -- Exact dark warm brown
            rail.BorderSizePixel = 0
            rail.Parent = sliderContainer

            local railCorner = Instance.new("UICorner")
            railCorner.CornerRadius = UDim.new(1, 0)
            railCorner.Parent = rail

            -- Filled Bar (peach color)
            local fill = Instance.new("Frame")
            fill.Name = "Fill"
            fill.AnchorPoint = Vector2.new(0, 0.5)
            fill.Position = UDim2.fromScale(0, 0.5)
            fill.Size = UDim2.fromScale(0, 1)
            fill.BackgroundColor3 = theme.primary
            fill.BorderSizePixel = 0
            fill.Parent = rail

            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(1, 0)
            fillCorner.Parent = fill

            -- Thumb (peach circle)
            local thumb = Instance.new("Frame")
            thumb.Name = "Thumb"
            thumb.AnchorPoint = Vector2.new(0.5, 0.5)
            thumb.Position = UDim2.fromScale(0, 0.5)
            thumb.Size = UDim2.fromOffset(16, 16)
            thumb.BackgroundColor3 = theme.primary
            thumb.BorderSizePixel = 0
            thumb.Parent = rail

            local thumbCorner = Instance.new("UICorner")
            thumbCorner.CornerRadius = UDim.new(1, 0)
            thumbCorner.Parent = thumb

            local currentValue = defaultVal
            local isDragging = false

            local function Snap(val)
                local snapped = math.floor((val - minVal) / step + 0.5) * step + minVal
                return math.clamp(snapped, minVal, maxVal)
            end

            local function SetFromValue(val, triggerCallback, animate)
                currentValue = Snap(val)
                local percent = math.clamp((currentValue - minVal) / (maxVal - minVal), 0, 1)
                valueLabel.Text = valueFormat(currentValue)

                local duration = animate and 0.15 or 0.04
                local tInfo = TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                Tween(fill, tInfo, { Size = UDim2.fromScale(percent, 1) })
                Tween(thumb, tInfo, { Position = UDim2.fromScale(percent, 0.5) })

                if triggerCallback then
                    task.spawn(callback, currentValue)
                end
            end

            local function UpdateFromInput(input)
                local mouseX = input.Position.X
                local railX = rail.AbsolutePosition.X
                local railWidth = rail.AbsoluteSize.X
                local ratio = math.clamp((mouseX - railX) / railWidth, 0, 1)
                local rawVal = minVal + (maxVal - minVal) * ratio
                SetFromValue(rawVal, true, false)
            end

            sliderContainer.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = true
                    Tween(thumb, TweenInfo.new(0.15), { Size = UDim2.fromOffset(20, 20) })
                    UpdateFromInput(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if isDragging then
                        isDragging = false
                        Tween(thumb, TweenInfo.new(0.15), { Size = UDim2.fromOffset(16, 16) })
                    end
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateFromInput(input)
                end
            end)

            SetFromValue(defaultVal, false, false)

            local SliderObj = {
                Value = currentValue,
                Tile = tile,
            }

            function SliderObj:Set(val)
                SetFromValue(val, true, true)
                SliderObj.Value = currentValue
            end

            return SliderObj
        end

