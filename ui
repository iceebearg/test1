    -- Window Open/Close & Dragging
    local isWindowOpen = true
    local function SetWindowVisible(visible)
        isWindowOpen = visible
        if visible then
            outerContainer.Visible = true
            Tween(mainContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                GroupTransparency = 0
            })
            Tween(shadow, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                ImageTransparency = 0.35
            })
            Tween(outerContainer, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = size
            })
        else
            Tween(mainContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                GroupTransparency = 1
            })
            Tween(shadow, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                ImageTransparency = 1
            })
            local tw = Tween(outerContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(size.X.Scale, size.X.Offset * 0.95, size.Y.Scale, size.Y.Offset * 0.95)
            })
            tw.Completed:Connect(function()
                if not isWindowOpen then
                    outerContainer.Visible = false
                end
            end)
        end
    end

    CreateIconButton("CloseBtn", MaterialUI.Icons.Close, 2, function()
        SetWindowVisible(false)
    end)

    -- Window dragging logic
    local dragging, dragStart, startPos = false, nil, nil
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = outerContainer.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Tween(outerContainer, TweenInfo.new(0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            })
        end
    end)

    -- Toggle keybind (default RightShift)
    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == toggleKey then
            SetWindowVisible(not isWindowOpen)
        end
    end)

