                rowPadding.PaddingLeft = UDim.new(0, 16)
                rowPadding.PaddingRight = UDim.new(0, 16)
                rowPadding.PaddingTop = UDim.new(0, 6)
                rowPadding.PaddingBottom = UDim.new(0, 6)
                rowPadding.Parent = row

                local rowLayout = Instance.new("UIListLayout")
                rowLayout.FillDirection = Enum.FillDirection.Horizontal
                rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
                rowLayout.Padding = UDim.new(0, 12)
                rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
                rowLayout.Parent = row

                -- Avatar thumbnail
                local avatar = Instance.new("ImageLabel")
                avatar.Name = "Avatar"
                avatar.Size = UDim2.fromOffset(38, 38)
                avatar.BackgroundColor3 = theme.surfaceVariant
                avatar.BorderSizePixel = 0
                avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(player.UserId) .. "&w=100&h=100"
                avatar.LayoutOrder = 1
                avatar.Parent = row

                local avatarCorner = Instance.new("UICorner")
                avatarCorner.CornerRadius = UDim.new(1, 0)
                avatarCorner.Parent = avatar

                -- Names column
                local textHolder = Instance.new("Frame")
                textHolder.Name = "TextHolder"
                textHolder.Size = UDim2.new(1, -52, 1, 0)
                textHolder.BackgroundTransparency = 1
                textHolder.LayoutOrder = 2
                textHolder.Parent = row

                local textLayout = Instance.new("UIListLayout")
                textLayout.SortOrder = Enum.SortOrder.LayoutOrder
                textLayout.FillDirection = Enum.FillDirection.Vertical
                textLayout.VerticalAlignment = Enum.VerticalAlignment.Center
                textLayout.Padding = UDim.new(0, 2)
                textLayout.Parent = textHolder

                local dispLabel = Instance.new("TextLabel")
                dispLabel.Name = "DisplayName"
                dispLabel.Size = UDim2.new(1, 0, 0, 18)
                dispLabel.BackgroundTransparency = 1
                dispLabel.Text = player.DisplayName
                dispLabel.TextColor3 = theme.onBackground
                dispLabel.TextSize = 15
                dispLabel.TextXAlignment = Enum.TextXAlignment.Left
                dispLabel.LayoutOrder = 1
                ApplyFont(dispLabel, "Bold")
                dispLabel.Parent = textHolder

                local userLabel = Instance.new("TextLabel")
                userLabel.Name = "Username"
                userLabel.Size = UDim2.new(1, 0, 0, 14)
                userLabel.BackgroundTransparency = 1
                userLabel.Text = "@" .. player.Name
                userLabel.TextColor3 = theme.onSurfaceVariant
                userLabel.TextSize = 12
                userLabel.TextXAlignment = Enum.TextXAlignment.Left
                userLabel.LayoutOrder = 2
                ApplyFont(userLabel, "Regular")
                userLabel.Parent = textHolder

                row.MouseEnter:Connect(function()
                    if selectedPlayer ~= player then
                        Tween(row, TweenInfo.new(0.18), { BackgroundTransparency = 0.96 })
                    end
                end)
                row.MouseLeave:Connect(function()
                    if selectedPlayer ~= player then
                        Tween(row, TweenInfo.new(0.18), { BackgroundTransparency = 1 })
                    end
                end)

                row.MouseButton1Click:Connect(function()
                    -- Deselect previous
                    for p, r in pairs(playerRows) do
                        Tween(r, TweenInfo.new(0.15), { BackgroundTransparency = 1, BackgroundColor3 = Color3.fromRGB(255, 255, 255) })
                    end
                    selectedPlayer = player
                    Tween(row, TweenInfo.new(0.15), { BackgroundTransparency = 0.85, BackgroundColor3 = theme.primary })
                    task.spawn(onPlayerClick, player)
                end)

                playerRows[player] = row
                FilterRows()
            end

            local function RemovePlayerRow(player)
                local row = playerRows[player]
                if row then
                    playerRows[player] = nil
                    row:Destroy()
                end
            end

            for _, player in ipairs(Players:GetPlayers()) do
                AddPlayerRow(player)
            end

            local conAdd = Players.PlayerAdded:Connect(AddPlayerRow)
            local conRemove = Players.PlayerRemoving:Connect(RemovePlayerRow)

            pcall(function()
                listContainer.Destroying:Connect(function()
                    conAdd:Disconnect()
                    conRemove:Disconnect()
                end)
            end)

            local ListObj = {
                Container = listContainer,
            }
            function ListObj:GetSelected()
                return selectedPlayer
            end
            return ListObj
        end

        -- ==============================================================
        -- COMPONENT: CreateLabel
        -- ==============================================================
        function TabObj:CreateLabel(text, desc, icon)
            TabObj.ItemCount = TabObj.ItemCount + 1

            local tile = Instance.new("Frame")
            tile.Name = "LabelTile"
            tile.Size = UDim2.new(1, 0, 0, desc and 52 or 38)
            tile.BackgroundTransparency = 1
            tile.LayoutOrder = TabObj.ItemCount
            tile.Parent = scrollPage

            local tilePadding = Instance.new("UIPadding")
            tilePadding.PaddingLeft = UDim.new(0, 16)
            tilePadding.PaddingRight = UDim.new(0, 16)
            tilePadding.PaddingTop = UDim.new(0, 6)
            tilePadding.PaddingBottom = UDim.new(0, 6)
            tilePadding.Parent = tile

            local leftContainer = Instance.new("Frame")
            leftContainer.Size = UDim2.fromScale(1, 1)
            leftContainer.BackgroundTransparency = 1
            leftContainer.Parent = tile

            local leftLayout = Instance.new("UIListLayout")
            leftLayout.FillDirection = Enum.FillDirection.Horizontal
            leftLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            leftLayout.Padding = UDim.new(0, 14)
            leftLayout.Parent = leftContainer

            if icon then
                local iconLabel = Instance.new("ImageLabel")
                iconLabel.Size = UDim2.fromOffset(20, 20)
                iconLabel.BackgroundTransparency = 1
                iconLabel.Image = icon
                iconLabel.ImageColor3 = theme.onSurfaceVariant
                iconLabel.Parent = leftContainer
            end

            local textHolder = Instance.new("Frame")
            textHolder.Size = UDim2.new(1, icon and -34 or 0, 1, 0)
            textHolder.BackgroundTransparency = 1
            textHolder.Parent = leftContainer

            local textLayout = Instance.new("UIListLayout")
            textLayout.SortOrder = Enum.SortOrder.LayoutOrder
            textLayout.FillDirection = Enum.FillDirection.Vertical
            textLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            textLayout.Padding = UDim.new(0, 2)
            textLayout.Parent = textHolder

            local titleLabel = Instance.new("TextLabel")
            titleLabel.Size = UDim2.new(1, 0, 0, 18)
            titleLabel.BackgroundTransparency = 1
            titleLabel.Text = text
            titleLabel.TextColor3 = theme.onSurface
            titleLabel.TextSize = 14
            titleLabel.TextXAlignment = Enum.TextXAlignment.Left
            titleLabel.LayoutOrder = 1
            ApplyFont(titleLabel, "Medium")
            titleLabel.Parent = textHolder

            if desc then
                local descLabel = Instance.new("TextLabel")
                descLabel.Size = UDim2.new(1, 0, 0, 14)
                descLabel.BackgroundTransparency = 1
                descLabel.Text = desc
                descLabel.TextColor3 = theme.onSurfaceVariant
                descLabel.TextSize = 12
                descLabel.TextXAlignment = Enum.TextXAlignment.Left
                descLabel.LayoutOrder = 2
                ApplyFont(descLabel, "Regular")
                descLabel.Parent = textHolder
            end

            return tile
        end

        return TabObj
    end

    table.insert(MaterialUI.Windows, WindowObj)
    return WindowObj
end

return MaterialUI
