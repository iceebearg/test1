        local function ActivateTab()
            for _, otherTab in ipairs(WindowObj.Tabs) do
                otherTab.Page.Visible = false
                Tween(otherTab.Button, TweenInfo.new(0.2), { BackgroundTransparency = 1 })
                local otherText = otherTab.Button:FindFirstChild("Label")
                if otherText then
                    Tween(otherText, TweenInfo.new(0.2), { TextColor3 = theme.onSurfaceVariant })
                end
                local otherIcon = otherTab.Button:FindFirstChildOfClass("ImageLabel")
                if otherIcon then
