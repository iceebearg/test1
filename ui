            Button = tabButton,
            ItemCount = 0,
        }

        local function ActivateTab()
            for _, otherTab in ipairs(WindowObj.Tabs) do
                otherTab.Page.Visible = false
                Tween(otherTab.Button, TweenInfo.new(0.18), {
                    BackgroundColor3 = theme.surfaceVariant,
                    BackgroundTransparency = 0.5
                })
                local otherStroke = otherTab.Button:FindFirstChildOfClass("UIStroke")
                if otherStroke then
                    Tween(otherStroke, TweenInfo.new(0.18), { Transparency = 1 })
                end
                local otherText = otherTab.Button:FindFirstChild("Label")
                if otherText then
                    Tween(otherText, TweenInfo.new(0.18), { TextColor3 = theme.onSurfaceVariant })
                end
                local otherIcon = otherTab.Button:FindFirstChild("Icon")
                if otherIcon then
                    Tween(otherIcon, TweenInfo.new(0.18), { ImageColor3 = theme.onSurfaceVariant })
                end
            end
            scrollPage.Visible = true
